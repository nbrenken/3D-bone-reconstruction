class FeatureExtractor(torch.nn.Module):
    def __init__(self, checkpoint_file: Path, DAX_model_type = "resnet50"):
        super().__init__()

        self.device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
        self.fusion = ViewAttentionFusion(channels=16, num_views=9)
        self.reducer1 = nn.Conv2d(256,  16, kernel_size=1)
        self.reducer2 = nn.Conv2d(512,  16, kernel_size=1)
        self.reducer3 = nn.Conv2d(1024, 16, kernel_size=1)
        self.reducer4 = nn.Conv2d(2048, 16, kernel_size=1)

        checkpoint = torch.load(checkpoint_file, map_location=self.device, weights_only=False)
        teacher_checkpoint = checkpoint["teacher"]
        
        # Extract backbone weights
        teacher_dict = {k.replace("module.backbone.", ""): v 
                    for k, v in teacher_checkpoint.items() 
                    if k.startswith("module.backbone.")}

        # Create model
        self.DAX = models.__dict__[DAX_model_type.lower()](weights=None)
        
        self.DAX.fc = nn.Identity()
        # Load weights
        self.DAX.load_state_dict(teacher_dict, strict=True)

        del self.DAX.avgpool
        del self.DAX.fc

        def forward_no_flatten(x):
            x = self.DAX.conv1(x)
            x = self.DAX.bn1(x)
            x = self.DAX.relu(x)
            x = self.DAX.maxpool(x)
            x1 = self.DAX.layer1(x)
            x2 = self.DAX.layer2(x1)
            x3 = self.DAX.layer3(x2)
            x4 = self.DAX.layer4(x3)
            #x5 = self.DAX.avgpool(x4)
            return x1, x2, x3, x4#, x5  
        
        # torch.Size([9, 256, 64, 64]) torch.Size([9, 512, 32, 32]) torch.Size([9, 1024, 16, 16]) 
        # torch.Size([9, 2048, 8, 8]) torch.Size([9, 2048, 1, 1])
        
        self.DAX.forward = forward_no_flatten

        self.to(self.device)
        self.DAX.eval()

        self.sample_grids = {}  # cache per image_size
        self.backprojector = BackprojectionModule(grid_size=80, world_size=125.0)

    def _get_sample_grids(self, P_matrices, grid_size, image_size):
        key = (image_size, grid_size)
        if key not in self.sample_grids:
            grids = []
            for i in range(P_matrices.shape[0]):
                X_proj = P_matrices[i] @ self.backprojector.X_hom
                depth = X_proj[2].clamp(min=1e-8)
                p_x = (X_proj[0] / depth / (image_size - 1)) * 2.0 - 1.0
                p_y = (X_proj[1] / depth / (image_size - 1)) * 2.0 - 1.0
                grids.append(torch.stack([p_x, p_y], dim=-1).reshape(1, 1, -1, 2))
            self.sample_grids[key] = grids
        return self.sample_grids[key]

    def forward(self, x, P_matrices, grid_size=80):
        x = x.to(self.device)
        P_matrices = P_matrices.to(self.device)

        # x: (B, V, C, H, W) or (V, C, H, W)
        if x.ndim == 4:
            x = x.unsqueeze(0)
        
        B, V, C, H, W = x.shape
        image_size = H

        # P_matrices: (V, 3, 4) → expand to (B, V, 3, 4)
        if P_matrices.ndim == 3:
            P_matrices = P_matrices.unsqueeze(0).expand(B, -1, -1, -1)

        # Merge batch and views for ResNet
        x_flat = x.reshape(B * V, C, H, W)

        with torch.no_grad():
            x1, x2, x3, x4 = self.DAX(x_flat)

        f1 = self.reducer1(x1)  # (B*V, 8, 64, 64)
        f2 = self.reducer2(x2)
        f3 = self.reducer3(x3)
        f4 = self.reducer4(x4)

        def backproject_batch(features, P_mats):
            _, C_f, H_f, W_f = features.shape
            features = features.reshape(B, V, C_f, H_f, W_f)
            grids = []
            for b in range(B):
                vol = self.backprojector(features[b], P_mats[b], image_size)
                grids.append(vol)  # (V, C, D, D, D)
            return torch.stack(grids, dim=0)  # (B, V, C, D, D, D)

        def fuse(grid):
            return self.fusion(grid)


        grid1 = backproject_batch(f1, P_matrices)
        grid2 = backproject_batch(f2, P_matrices)
        grid3 = backproject_batch(f3, P_matrices)
        grid4 = backproject_batch(f4, P_matrices)

        grid1 = fuse(grid1)
        grid2 = fuse(grid2)
        grid3 = fuse(grid3)
        grid4 = fuse(grid4)

        return torch.cat([grid1, grid2, grid3, grid4], dim=1)  # (B, 128, D, D, D)

        

############################################
# -------- UNET ----------------------------
############################################
class Down3d(nn.Module):
    def __init__(self, in_ch, out_ch, stride):
        super().__init__()
        self.pool = nn.MaxPool3d(stride)
        self.block = ResBlock3D(in_ch, out_ch)

    def forward(self, x):
        return self.block(self.pool(x))
    
class Up3d(nn.Module):
    def __init__(self, in_ch, out_ch, stride):
        super().__init__()
        self.up = nn.ConvTranspose3d(in_ch, in_ch//2, kernel_size=2, stride=stride)
        self.block = ResBlock3D(in_ch, out_ch)

    def forward(self, x, skip):
        x = self.up(x)
        cat_dim = 1 if x.ndim == 5 else 0
        x = torch.cat([x, skip], dim=cat_dim)
        return self.block(x)


class ViewAttentionFusion(nn.Module):
    def __init__(self, channels, num_views):
        super().__init__()
        self.attn = nn.Sequential(
            nn.Conv3d(channels * num_views, channels, 1),
            nn.ReLU(),
            nn.Conv3d(channels, num_views, 1)
        )

    def forward(self, x):
        B, V, C, D, H, W = x.shape
        x_flat = x.view(B, V*C, D, H, W)
        attn = self.attn(x_flat)
        attn = torch.softmax(attn, dim=1)
        return (x * attn.unsqueeze(2)).sum(dim=1)


class ResBlock3D(nn.Module):
    def __init__(self, in_ch, out_ch):
        super().__init__()
        self.conv1 = nn.Conv3d(in_ch, out_ch, 3, padding=1)
        self.bn1 = nn.InstanceNorm3d(out_ch)
        self.conv2 = nn.Conv3d(out_ch, out_ch, 3, padding=1)
        self.bn2 = nn.InstanceNorm3d(out_ch)

        self.skip = nn.Conv3d(in_ch, out_ch, 1) if in_ch != out_ch else nn.Identity()

    def forward(self, x):
        identity = self.skip(x)
        x = F.relu(self.bn1(self.conv1(x)))
        x = self.bn2(self.conv2(x))
        return F.relu(x + identity)


############################################
# -------- REFINER -------------------------
############################################
class Refiner(nn.Module):
    def __init__(self):
        super().__init__()
        self.conv1 = ResBlock3D(96, 32)
        self.down1 = Down3d(32, 64, stride=2)
        self.down2 = Down3d(64, 128, stride=2)
        self.bottleneck = Down3d(128, 256, stride=2)
        self.up1 = Up3d(256, 128, stride=2)
        self.up2 = Up3d(128, 64, stride=2)
        self.up3 = Up3d(64, 32, stride=2)
        self.final = nn.Conv3d(32, 1, kernel_size=1)

    def forward(self, feature_grid):
        x = self.conv1(feature_grid)

        s1 = F.relu(x)       # (B, 32, D, D, D)

        s2 = self.down1(s1)     # (B, 64, D/2)
        s3 = self.down2(s2)     # (B, 128, D/4)

        b = self.bottleneck(s3) # (B, 256, D/8)

        x = self.up1(b, s3)     # (B, 128, D/4)
        x = self.up2(x, s2)     # (B, 64, D/2)
        x = self.up3(x, s1)     # (B, 32, D)

        x = self.final(x)

        return x


############################################
# -------- MODEL ---------------------------
############################################
class ReconstructionModel(nn.Module):
    def __init__(self, feature_extractor, refiner):
        super().__init__()
        self.feature_extractor = feature_extractor
        self.refiner = refiner
        self.embedding = nn.Embedding(50, 32)

    def forward(self, x, P, vertebra_idx):
        feat = self.feature_extractor(x, P)

        emb = self.embedding(vertebra_idx)
        emb = emb[:, :, None, None, None]
        emb = emb.expand(-1, -1, feat.shape[2], feat.shape[3], feat.shape[4])

        feat = torch.cat([feat, emb], dim=1)

        return self.refiner(feat)


############################################
# -------- PROJECTION MATRICES -------------
############################################
def get_projection_matrices():
    import numpy as np
    import torch

    K = np.array([[2400, 0, 128],
                  [0, 2400, 128],
                  [0, 0, 1]])

    SDD = 1200.0

    def make_P(R, t_world):
        R = np.array(R, dtype=np.float64)
        t_world = np.array(t_world, dtype=np.float64).reshape(3, 1)
        return K @ R @ np.hstack((np.eye(3), -t_world))

    # ---------------- AP ----------------
    R_AP = [[1, 0, 0],
            [0, 1, 0],
            [0, 0, 1]]
    t_AP = [0, 0, -SDD]

    # ---------------- LATERAL LEFT ----------------
    R_LateralLeft = [[0, 0, -1],
                     [0, 1,  0],
                     [1, 0,  0]]
    t_LateralLeft = [-SDD, 0, 0]

    # ---------------- LATERAL RIGHT ----------------
    R_LateralRight = [[0,  0, 1],
                      [0,  1, 0],
                      [-1, 0, 0]]
    t_LateralRight = [SDD, 0, 0]

    # ---------------- OBLIQUE LEFT (45°) ----------------
    angle = np.radians(45)
    ca, sa = np.cos(angle), np.sin(angle)

    R_ObliqueLeft = [[ca,  0, -sa],
                     [0,   1,  0],
                     [sa,  0,  ca]]
    t_ObliqueLeft = [-SDD * sa, 0, -SDD * ca]

    # ---------------- OBLIQUE RIGHT (45°) ----------------
    R_ObliqueRight = [[ca,  0, sa],
                      [0,   1, 0],
                      [-sa, 0, ca]]
    t_ObliqueRight = [SDD * sa, 0, -SDD * ca]

    # ---------------- CRANIAL TILT (10°) ----------------
    tilt = np.radians(10)
    ct, st = np.cos(tilt), np.sin(tilt)

    R_AP_Cranial = [[1, 0,   0],
                    [0, ct, -st],
                    [0, st,  ct]]
    t_AP_Cranial = [0, -SDD * st, -SDD * ct]

    # ---------------- CAUDAL TILT (10°) ----------------
    R_AP_Caudal = [[1, 0,    0],
                   [0, ct,   st],
                   [0, -st,  ct]]
    t_AP_Caudal = [0, SDD * st, -SDD * ct]

    # ---------------- PEDICLE LEFT ----------------
    oblique_angle = np.radians(30)
    tilt_angle = np.radians(10)

    co, so = np.cos(oblique_angle), np.sin(oblique_angle)
    ct, st = np.cos(tilt_angle), np.sin(tilt_angle)

    R_oblique_y = np.array([[co,  0, so],
                            [0,   1, 0],
                            [-so, 0, co]])

    R_tilt_x = np.array([[1, 0,   0],
                         [0, ct,  st],
                         [0, -st, ct]])

    R_PedicleLeft = R_tilt_x @ R_oblique_y
    t_PedicleLeft = -SDD * R_PedicleLeft[2, :]

    # ---------------- PEDICLE RIGHT ----------------
    R_oblique_y_right = np.array([[co,  0, -so],
                                 [0,   1,  0],
                                 [so,  0,  co]])

    R_PedicleRight = R_tilt_x @ R_oblique_y_right
    t_PedicleRight = -SDD * R_PedicleRight[2, :]

    # ---------------- BUILD MATRICES ----------------
    projection_stack = np.stack(
        [
            make_P(R_AP_Caudal, t_AP_Caudal),
            make_P(R_AP_Cranial, t_AP_Cranial),
            make_P(R_AP, t_AP),
            make_P(R_LateralLeft, t_LateralLeft),
            make_P(R_LateralRight, t_LateralRight),
            make_P(R_ObliqueLeft, t_ObliqueLeft),
            make_P(R_ObliqueRight, t_ObliqueRight),
            make_P(R_PedicleLeft, t_PedicleLeft),
            make_P(R_PedicleRight, t_PedicleRight),
        ],
        axis=0,
    )

    return torch.tensor(projection_stack, dtype=torch.float32)


############################################
# -------- MESH + PLOT ---------------------
############################################
def voxels_to_mesh(voxels):
    verts, faces, normals, _ = measure.marching_cubes(voxels, level=0.5)
    return trimesh.Trimesh(verts, faces, vertex_normals=normals)


def plot_mesh(mesh):
    fig = plt.figure(figsize=(8,8))
    ax = fig.add_subplot(111, projection='3d')

    mesh_collection = Poly3DCollection(mesh.vertices[mesh.faces], alpha=0.7)
    mesh_collection.set_edgecolor('k')

    ax.add_collection3d(mesh_collection)

    scale = mesh.vertices.flatten()
    ax.auto_scale_xyz(scale, scale, scale)

    plt.tight_layout()
    plt.show()


