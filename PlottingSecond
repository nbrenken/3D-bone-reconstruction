# -------- MAIN ----------------------------
############################################
def main():

    device = torch.device("cuda" if torch.cuda.is_available() else "cpu")

    model = ReconstructionModel(
        FeatureExtractor(DAX_CHECKPOINT),
        Refiner()
    ).to(device)

    state = torch.load(MODEL_PATH, map_location=device, weights_only=True)
    model.load_state_dict(state)
    model.eval()

    images = load_9_images(IMAGE_DIR).to(device)
    P = get_projection_matrices().to(device)

    vertebra_name = input("Enter vertebra (e.g. L1, L2, L3...): ")

    if vertebra_name not in vertebra_to_idx:
        raise ValueError(f"Unknown vertebra: {vertebra_name}")

    vertebra_idx = torch.tensor(
        [vertebra_to_idx[vertebra_name]],
        dtype=torch.long,
        device=device
    )

    with torch.no_grad():
        logits = model(images, P, vertebra_idx)
        probs = torch.sigmoid(logits)

    voxels = probs.squeeze().cpu().numpy()

    print("Voxel stats:", voxels.min(), voxels.max())
    print("Occupied:", (voxels > THRESHOLD).sum())

    mesh = voxels_to_mesh(voxels > THRESHOLD)

    mesh.vertices -= GRID_SIZE / 2
    mesh.vertices *= (125.0 / GRID_SIZE)

    mesh.export(OUTPUT_MESH)
    print("Saved mesh:", OUTPUT_MESH)

    plot_mesh(mesh)


if __name__ == "__main__":
    main()
