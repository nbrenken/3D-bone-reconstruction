def plot_voxel_grid_3d(voxels: np.ndarray, max_points: int = 20000):
    """Plot a voxel grid as a sampled point cloud for interactive speed."""
    filled = voxels.astype(bool)
    fig = plt.figure(figsize=(8, 8))
    ax = fig.add_subplot(111, projection="3d")

    filled_count = int(filled.sum())
    if filled_count == 0:
        print("Voxel grid is empty; nothing to plot.")
        return

    coords = np.argwhere(filled)
    if coords.shape[0] > max_points:
        sample_idx = np.random.choice(coords.shape[0], size=max_points, replace=False)
        coords = coords[sample_idx]
        print(f"Showing {max_points}/{filled_count} occupied voxels for faster rendering.")

    ax.scatter(
        coords[:, 0].tolist(),
        coords[:, 1].tolist(),
        coords[:, 2].tolist(),
        s=1,
        c="steelblue",
        alpha=0.8,
    )

    ax.set_xlabel("X")
    ax.set_ylabel("Y")
    ax.set_zlabel("Z")
    ax.set_box_aspect(filled.shape)
    plt.tight_layout()
    plt.show()


def plot_voxel_fixed_view_3d(
    voxels: np.ndarray,
    max_points: int = 200000,
    elev: float = 20,
    azim: float = 35,
    save_path: str = "voxel_fixed_view.png",
    show: bool = False,
):
    """Render a fixed-angle 3D voxel view and optionally save it without interaction."""
    filled = np.squeeze(voxels).astype(bool)
    if filled.ndim != 3:
        raise ValueError(f"plot_voxel_fixed_view_3d expects a 3D voxel grid after squeeze, got shape {filled.shape}")

    filled_count = int(filled.sum())
    if filled_count == 0:
        print("Voxel grid is empty; nothing to plot.")
        return

    coords = np.argwhere(filled)
    if coords.shape[0] > max_points:
        sample_idx = np.random.choice(coords.shape[0], size=max_points, replace=False)
        coords = coords[sample_idx]
        print(f"Showing {max_points}/{filled_count} occupied voxels for faster rendering.")

    fig = plt.figure(figsize=(8, 8))
    ax = fig.add_subplot(111, projection="3d")
    ax.scatter(
        coords[:, 0].tolist(),
        coords[:, 1].tolist(),
        coords[:, 2].tolist(),
        s=1,
        c="steelblue",
        alpha=0.8,
    )
    ax.view_init(elev=elev, azim=azim)
    ax.set_title("Voxel Grid (Fixed 3D View)")
    ax.set_xlabel("X")
    ax.set_ylabel("Y")
    ax.set_zlabel("Z")
    ax.set_box_aspect(filled.shape)
    plt.tight_layout()
    if save_path:
        plt.savefig(save_path, dpi=200)
        print(f"Saved fixed-view 3D plot to {save_path}")
    if show:
        plt.show()
    else:
        plt.close(fig)


def plot_voxel_comparison_fixed_view_3d(
    prediction_voxels: np.ndarray,
    ground_truth_voxels: np.ndarray,
    max_points: int = 200000,
    elev: float = 20,
    azim: float = 35,
    save_path: str = "voxel_comparison_fixed_view.png",
):
    """Render prediction and ground truth side-by-side in one non-interactive figure."""
    pred = np.squeeze(prediction_voxels).astype(bool)
    gt = np.squeeze(ground_truth_voxels).astype(bool)

    if pred.ndim != 3:
        raise ValueError(f"plot_voxel_comparison_fixed_view_3d expects prediction to be 3D after squeeze, got shape {pred.shape}")
    if gt.ndim != 3:
        raise ValueError(f"plot_voxel_comparison_fixed_view_3d expects ground truth to be 3D after squeeze, got shape {gt.shape}")

    pred_coords = np.argwhere(pred)
    gt_coords = np.argwhere(gt)

    if pred_coords.shape[0] == 0 and gt_coords.shape[0] == 0:
        print("Both voxel grids are empty; nothing to plot.")
        return

    if pred_coords.shape[0] > max_points:
        sample_idx = np.random.choice(pred_coords.shape[0], size=max_points, replace=False)
        pred_coords = pred_coords[sample_idx]
        print(f"Prediction: showing {max_points}/{int(pred.sum())} occupied voxels for faster rendering.")

    if gt_coords.shape[0] > max_points:
        sample_idx = np.random.choice(gt_coords.shape[0], size=max_points, replace=False)
        gt_coords = gt_coords[sample_idx]
        print(f"Ground truth: showing {max_points}/{int(gt.sum())} occupied voxels for faster rendering.")

    fig = plt.figure(figsize=(14, 7))
    ax_pred = fig.add_subplot(121, projection="3d")
    ax_gt = fig.add_subplot(122, projection="3d")

    if pred_coords.shape[0] > 0:
        ax_pred.scatter(
            pred_coords[:, 0].tolist(),
            pred_coords[:, 1].tolist(),
            pred_coords[:, 2].tolist(),
            s=1,
            c="tomato",
            alpha=0.8,
        )

    if gt_coords.shape[0] > 0:
        ax_gt.scatter(
            gt_coords[:, 0].tolist(),
            gt_coords[:, 1].tolist(),
            gt_coords[:, 2].tolist(),
            s=1,
            c="steelblue",
            alpha=0.8,
        )

    ax_pred.set_title("Prediction")
    ax_gt.set_title("Ground Truth")

    for ax, shape in ((ax_pred, pred.shape), (ax_gt, gt.shape)):
        ax.view_init(elev=elev, azim=azim)
        ax.set_xlabel("X")
        ax.set_ylabel("Y")
        ax.set_zlabel("Z")
        ax.set_box_aspect(shape)

    plt.tight_layout()
    if save_path:
        plt.savefig(save_path, dpi=200)
        print(f"Saved side-by-side fixed-view plot to {save_path}")
    plt.close(fig)


class BackprojectionModule(nn.Module):
    def __init__(self, grid_size=80, world_size=125.0):
        super().__init__()
        lin = torch.linspace(-world_size/2, world_size/2, grid_size)
        x, y, z = torch.meshgrid(lin, lin, lin, indexing='ij')
        X_hom = torch.stack([x.reshape(-1), y.reshape(-1), z.reshape(-1), torch.ones(grid_size**3)], dim=0)
        self.register_buffer('X_hom', X_hom)  # moves with model to GPU, created once
        self.grid_size = grid_size

    def forward(self, features, projection_matrices, image_size=256):
        N, C, H, W = features.shape
        view_grids = []
        for i in range(N):
            P = projection_matrices[i]
            feat = features[i]
            X_proj = P @ self.X_hom
            depth = X_proj[2].clamp(min=1e-8)
            p_x = (X_proj[0] / depth / (image_size - 1)) * 2.0 - 1.0
            p_y = (X_proj[1] / depth / (image_size - 1)) * 2.0 - 1.0
            sample_grid = torch.stack([p_x, p_y], dim=-1).reshape(1, 1, -1, 2)
            sampled = F.grid_sample(feat.unsqueeze(0), sample_grid, mode='bilinear',
                                    padding_mode='zeros', align_corners=True).squeeze(0).squeeze(1)
            view_grids.append(sampled.reshape(C, self.grid_size, self.grid_size, self.grid_size))
        return torch.stack(view_grids, dim=0)


class SpineDataset(Dataset):
    def __init__(self, drr_dir: Path, cache_dir: Path, transform=None):
        self.drr_dir = drr_dir
        self.cache_dir = cache_dir
        self.transform = transform or transforms.ToTensor()
        self.samples = []
        self.vertebra_to_idx = {}
        current_idx = 0

        # --- STEP 1: LOAD SAMPLES ---
        for patient in self.drr_dir.iterdir():
            if patient.is_dir():
                for vertebra in patient.iterdir():
                    if vertebra.is_dir():
                        if vertebra.name == "L5": #Lil note: L5 removed because of bad data
                            continue
                        mesh_files = list(vertebra.glob("*.npz"))
                        if not mesh_files:
                            continue

                        cache_path = self.cache_dir / f"{patient.name}_{vertebra.name}.npy"
                        if not cache_path.exists():
                            continue

                        self.samples.append({
                            "patient": patient.name,
                            "vertebra": vertebra.name,
                            "mesh_file": mesh_files[0],
                            "drr_files": [drr_file for drr_file in sorted(vertebra.glob("*full.png"))],
                        })


        # --- STEP 2: BUILD VERTEBRA INDEX ---
        self.vertebra_to_idx = {}
        current_idx = 0

        for sample in self.samples:
            v = sample["vertebra"]
            if v not in self.vertebra_to_idx:
                self.vertebra_to_idx[v] = current_idx
                current_idx += 1

        print("Vertebra mapping:", self.vertebra_to_idx)



        for sample in self.samples:
            v = sample["vertebra"]
            if v not in self.vertebra_to_idx:
                self.vertebra_to_idx[v] = current_idx
                current_idx += 1


        K = [[2400, 0, 128],[0, 2400, 128],[0, 0, 1]]
        SDD = 1200.0

        def make_P(R, t_world, K):
            """
            R: rotation from world to camera coordinates
            t_world: camera position in world coordinates (3,1)
            P = K @ R @ [I | -t_world]
            """
            R = np.array(R, dtype=np.float64)
            t_world = np.array(t_world, dtype=np.float64).reshape(3, 1)
            P = K @ R @ np.hstack((np.eye(3), -t_world))
            return P

        # AP: camera at (0, 0, -SDD), looking along +Z
        # World-to-camera: Z_world -> Z_cam (optical axis), X_world -> X_cam, Y_world -> Y_cam
        R_AP = [[1, 0, 0],
                [0, 1, 0],
                [0, 0, 1]]
        t_AP = [0, 0, -SDD]

        # Lateral Left: camera at (-SDD, 0, 0), looking along +X
        # Camera z-axis = world x-axis, camera x-axis = world -z-axis, camera y-axis = world y-axis
                # Lateral Left: camera at (-SDD, 0, 0), looking along +X
        # cam_z = [1, 0, 0]  (optical axis, toward origin)
        # cam_y = [0, 1, 0]  (image vertical = world Y)
        # cam_x = cam_y × cam_z = [0,1,0] × [1,0,0] = [0,0,-1]
        # det check: needed
        R_LateralLeft = np.array([[0, 0, -1],
                                [0, 1,  0],
                                [1, 0,  0]])
        t_LateralLeft = [-SDD, 0, 0]
        # det = 0(0-0) - 0(0-(-1)) + (-1)(0-1) = +1 ✓

        # Lateral Right: camera at (+SDD, 0, 0), looking along -X
        # cam_z = [-1, 0, 0]
        # cam_y = [0, 1, 0]
        # cam_x = cam_y × cam_z = [0,1,0] × [-1,0,0] = [0,0,1]
        R_LateralRight = np.array([[0,  0, 1],
                                [0,  1, 0],
                                [-1, 0, 0]])
        t_LateralRight = [SDD, 0, 0]
        # det = 0(0-0) - 0(0-(-1)) + 1(0-(-1)) = +1 ✓

        # Oblique Left 45°: camera rotated 45° from AP toward left lateral
        # Camera is at position rotated -45° around Y from AP position
        angle = np.radians(45)
        ca, sa = np.cos(angle), np.sin(angle)
        # Camera position: rotate (0,0,-SDD) by -45° around Y
        t_ObliqueLeft = [-SDD * sa, 0, -SDD * ca]
        # R rotates world to camera: camera looks toward origin from t
        # Camera z-axis (optical) points from t toward origin = -t/|t| in world
        # = [sa, 0, ca]
        # Camera y-axis stays as world Y = [0, 1, 0]
        # Camera x-axis = y cross z = [0,1,0] x [sa,0,ca] = [ca, 0, -sa]
        R_ObliqueLeft = [[ca,  0, -sa],
                        [0,   1,  0],
                        [sa,  0,  ca]]
        t_ObliqueLeft = [-SDD * sa, 0, -SDD * ca]

        # Oblique Right 45°: mirror of left
        R_ObliqueRight = [[ca,  0, sa],
                        [0,   1, 0],
                        [-sa, 0, ca]]
        t_ObliqueRight = [SDD * sa, 0, -SDD * ca]

        # Cranial tilt (10°): camera tilted around X axis from AP
        tilt = np.radians(10)
        ct, st = np.cos(tilt), np.sin(tilt)
        R_AP_Cranial = [[1, 0,   0],
                        [0, ct, -st],
                        [0, st,  ct]]
        t_AP_Cranial = [0, -SDD * st, -SDD * ct]

        # Caudal tilt (10°): opposite direction
        R_AP_Caudal = [[1, 0,    0],
                    [0, ct,   st],
                    [0, -st,  ct]]
        t_AP_Caudal = [0, SDD * st, -SDD * ct]

        # Pedicle Left: ~30° oblique + ~10° cranial tilt
        oblique_angle = np.radians(30)
        tilt_angle = np.radians(10)

        co, so = np.cos(oblique_angle), np.sin(oblique_angle)
        ct, st = np.cos(tilt_angle), np.sin(tilt_angle)

        # Viewing direction: rotate AP direction [0,0,1] by 30° around Y, then 10° around X
        # After Y rotation: [so, 0, co] = [sin30, 0, cos30]
        # After X tilt: [so, -co*st, co*ct] = [sin30, -cos30*sin10, cos30*cos10]
        view_dir = np.array([so, -co * st, co * ct])

        # cam_z = view_dir (optical axis)
        # cam_y: start with world Y [0,1,0], but need to account for tilt
        # Safest: build R by composing rotations
        # R = R_tilt_x @ R_oblique_y

        R_oblique_y = np.array([[co,  0, so],
                                [0,   1, 0],
                                [-so, 0, co]])

        R_tilt_x = np.array([[1, 0,   0],
                            [0, ct,  st],
                            [0, -st, ct]])

        R_PedicleLeft = R_tilt_x @ R_oblique_y
        t_PedicleLeft = -SDD * R_PedicleLeft[2, :]  # camera at -SDD * viewing_direction

        # Pedicle Right: mirror oblique angle
        R_oblique_y_right = np.array([[co,  0, -so],
                                    [0,   1,  0],
                                    [so,  0,  co]])

        R_PedicleRight = R_tilt_x @ R_oblique_y_right
        t_PedicleRight = -SDD * R_PedicleRight[2, :]

        P_Pedicle_Left = make_P(R_PedicleLeft, t_PedicleLeft, K)
        P_Pedicle_Right = make_P(R_PedicleRight, t_PedicleRight, K)

        # Build all P matrices
        P_AP = make_P(R_AP, t_AP, K)
        P_LateralLeft = make_P(R_LateralLeft, t_LateralLeft, K)
        P_LateralRight = make_P(R_LateralRight, t_LateralRight, K)
        P_Oblique_Left = make_P(R_ObliqueLeft, t_ObliqueLeft, K)
        P_Oblique_Right = make_P(R_ObliqueRight, t_ObliqueRight, K)
        P_AP_Cranial = make_P(R_AP_Cranial, t_AP_Cranial, K)
        P_AP_Caudal = make_P(R_AP_Caudal, t_AP_Caudal, K)

        projection_stack = np.stack(
            [
                P_AP_Caudal,
                P_AP_Cranial,
                P_AP,
                P_LateralLeft,
                P_LateralRight,
                P_Oblique_Left,
                P_Oblique_Right,
                P_Pedicle_Left,
                P_Pedicle_Right
            ],
            axis=0,
        )
        self.projection_matrices = torch.from_numpy(projection_stack).to(dtype=torch.float32)


    def __len__(self):
        return len(self.samples)

    def __getitem__(self, idx):
        sample = self.samples[idx]
    
    # Load cached voxels
        cache_path = self.cache_dir / f"{sample['patient']}_{sample['vertebra']}.npy"
        voxels = np.load(cache_path)

        # Load images
        drr_images = []
        for drr_path in sample["drr_files"]:
            img = np.array(Image.open(drr_path)).astype(np.float32) / 65535.0
            img = torch.tensor(img).unsqueeze(0).repeat(3, 1, 1)
            drr_images.append(img)

        vertebra_idx = self.vertebra_to_idx[sample["vertebra"]]

        return torch.stack(drr_images, dim=0), voxels, vertebra_idx


